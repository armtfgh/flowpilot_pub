# Copy to .env in the directory where you launch FlowPilot.
# Existing process environment variables take precedence.
# To select a specific file, set FLOWPILOT_ENV_FILE before launch.

# Provider credentials: configure only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Writable records, indexes, inventory profiles and run outputs.
# FLOWPILOT_HOME=~/.flowpilot
# FLOWPILOT_INVENTORY_PROFILE_DIR=~/.flowpilot/data/inventory_profiles

# Local model endpoints must be OpenAI-compatible.
# FLOWPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# FLOWPILOT_OLLAMA_MODEL=your-installed-model
# FLOWPILOT_QWEN36_BASE_URL=http://127.0.0.1:8000/v1
# FLOWPILOT_QWEN38_BASE_URL=http://127.0.0.1:8001/v1

# Default pipeline models; availability depends on the configured provider.
# FLOWPILOT_SONNET_MODEL=claude-sonnet-4-6
# FLOWPILOT_OPUS_MODEL=claude-opus-4-6
# FLOWPILOT_ENGINE_PROVIDER=openai
# FLOWPILOT_ENGINE_MODEL_OPENAI=gpt-4o
# FLOWPILOT_ENGINE_MODEL_ANTHROPIC=claude-sonnet-4-6
# FLOWPILOT_EMBEDDING_MODEL=text-embedding-3-small

# Advanced: collection names for a user-managed Chroma index.
# FLOWPILOT_COLLECTION_NAME=flowpilot_records
# FLOWPILOT_PAIRS_COLLECTION_NAME=flowpilot_pairs
